+int VkComputePrivate::submit_command()
+{
+    const uint32_t family = vkdev->info.compute_queue_family_index();
+    VkQueue queue = vkdev->acquire_queue(family);
+    if (!queue)
+        return -1;
+    VkSubmitInfo info = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    info.commandBufferCount = 1;
+    info.pCommandBuffers = &compute_command_buffer;
+    VkResult result = vkQueueSubmit(queue, 1, &info, compute_command_fence);
+    vkdev->reclaim_queue(family, queue);
+    if (result != VK_SUCCESS)
+    {
+        NCNN_LOGE("vkQueueSubmit failed %d", result);
+        return -1;
+    }
+    result = vkWaitForFences(vkdev->vkdevice(), 1, &compute_command_fence, VK_TRUE, (uint64_t)-1);
+    if (result != VK_SUCCESS)
+    {
+        NCNN_LOGE("vkWaitForFences failed %d", result);
+        return -1;
+    }
+    return 0;
+}
+
+int VkCompute::elapsed_gpu_ms(double& ms) const
+{
+    if (!d->submitted || !d->timing_pool)
+        return -1;
+    uint64_t ticks[2];
+    if (vkGetQueryPoolResults(vkdev->vkdevice(), d->timing_pool, 0, 2, sizeof(ticks), ticks,
+                              sizeof(ticks[0]), VK_QUERY_RESULT_64_BIT) != VK_SUCCESS)
+        return -1;
+    const uint64_t mask = d->timestamp_bits == 64 ? (uint64_t)-1 : ((uint64_t)1 << d->timestamp_bits) - 1;
+    ms = double((ticks[1] - ticks[0]) & mask) * vkdev->info.timestamp_period() / 1000000.0;
+    return 0;
+}
+
+int VkCompute::resubmit_and_wait()
+{
+    if (!d->reusable || !d->submitted || !d->upload_staging_buffers.empty() ||
+        !d->download_post_buffers.empty() || !d->image_blocks_to_destroy.empty())
+        return -1;
+    if (vkResetFences(vkdev->vkdevice(), 1, &d->compute_command_fence) != VK_SUCCESS)
+        return -1;
+    return d->submit_command();
+}
