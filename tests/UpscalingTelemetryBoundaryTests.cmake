foreach(required NORMAL_LIBRARY DIAGNOSTIC_LIBRARY NORMAL_DEFINES DIAGNOSTIC_DEFINES INSTALL_SCRIPT)
    if(NOT EXISTS "${${required}}")
        message(FATAL_ERROR "Missing boundary input: ${required}")
    endif()
endforeach()
file(STRINGS "${NORMAL_LIBRARY}" normal_symbols REGEX "OverflowTelemetry|ReadOverflowCounts|FormatOverflowReport")
if(normal_symbols)
    message(FATAL_ERROR "Telemetry symbols leaked into normal upscaling library")
endif()
file(STRINGS "${DIAGNOSTIC_LIBRARY}" diagnostic_symbols REGEX "OverflowTelemetry|ReadOverflowCounts|FormatOverflowReport")
if(NOT diagnostic_symbols)
    message(FATAL_ERROR "Diagnostic control is missing telemetry symbols")
endif()
file(READ "${NORMAL_DEFINES}" normal_defines)
file(READ "${DIAGNOSTIC_DEFINES}" diagnostic_defines)
if(normal_defines MATCHES "LLCV_UPSCALING_TELEMETRY|LLCV_TEST_PROFILE")
    message(FATAL_ERROR "Diagnostic layout/profile macro leaked into regular app")
endif()
if(NOT diagnostic_defines MATCHES "LLCV_UPSCALING_TELEMETRY" OR NOT diagnostic_defines MATCHES "LLCV_TEST_PROFILE")
    message(FATAL_ERROR "Diagnostic viewer must have telemetry layout AND isolated profiles")
endif()
file(READ "${INSTALL_SCRIPT}" installer)
if(installer MATCHES "LowLatencyCaptureViewer_UpscalingDiagnostic\\.exe|UpscalingTelemetryTests\\.exe")
    message(FATAL_ERROR "Diagnostic executables must not be installed as release files")
endif()
message(STATUS "PASS: normal library/macro boundary, diagnostic positive control, profile isolation and release install exclusion")
