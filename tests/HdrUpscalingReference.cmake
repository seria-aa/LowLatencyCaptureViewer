# Legacy HDR AA is comparison-only: never embed these shaders in the app/library.
function(llcv_hdr_reference_shaders)
    set(llcv_shader_headers "")
    set(llcv_shader_dir "${CMAKE_CURRENT_BINARY_DIR}/generated/hdr-reference")
    file(MAKE_DIRECTORY "${llcv_shader_dir}")
    llcv_shader(decodePq tests/shaders/HdrCmaaTransfer.hlsl DecodePq ps_5_0)
    llcv_shader(encodePq tests/shaders/HdrCmaaTransfer.hlsl EncodePq ps_5_0)
    foreach(quality IN ITEMS "" "Preserve")
        if(quality STREQUAL "Preserve")
            set(defines ${cmaa_preserve_defines})
        else()
            set(defines ${cmaa_defines})
        endif()
        foreach(pair IN ITEMS "Edges,EdgesColor2x2CS" "Args,ComputeDispatchArgsCS" "Candidates,ProcessCandidatesCS" "Apply,DeferredColorApply2x2CS")
            string(REPLACE "," ";" fields "${pair}")
            list(GET fields 0 suffix)
            list(GET fields 1 entry)
            llcv_shader(cmaaHdr${quality}${suffix} third_party/upscaling/cmaa2/CMAA2.hlsl ${entry} cs_5_0
                ${defines} /D CMAA2_SUPPORT_HDR_COLOR_RANGE=1)
        endforeach()
    endforeach()
    target_sources(CmaaNisTests PRIVATE ${llcv_shader_headers})
    target_include_directories(CmaaNisTests PRIVATE "${llcv_shader_dir}")
endfunction()
llcv_hdr_reference_shaders()
