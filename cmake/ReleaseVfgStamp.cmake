# Bind the v2.3.0 VFG + SM86 release configuration to the linked executable.
file(SHA256 "${exe}" actual)
set(stamp "${build}/llcv-release-vfg-sm86.sha256")
if(write_stamp)
    file(WRITE "${stamp}.tmp" "${actual}\n")
    file(RENAME "${stamp}.tmp" "${stamp}")
else()
    if(NOT EXISTS "${stamp}")
        message(FATAL_ERROR "Build the VFG + SM86 release executable before packaging")
    endif()
    file(STRINGS "${stamp}" expected LIMIT_COUNT 1)
    if(NOT "${expected}" STREQUAL "${actual}")
        message(FATAL_ERROR "VFG release stamp does not match the executable; rebuild before packaging")
    endif()
endif()
