# Bind the bundled RIFE build to the linked executable.
set(stamp "${build}/llcv-release-rife-vulkan.sha256")
file(SHA256 "${exe}" actual)
if(write_stamp)
    file(WRITE "${stamp}.tmp" "${actual}\n")
    file(RENAME "${stamp}.tmp" "${stamp}")
else()
    if(NOT EXISTS "${stamp}")
        message(FATAL_ERROR "Build the bundled RIFE Vulkan executable before packaging")
    endif()
    file(STRINGS "${stamp}" expected LIMIT_COUNT 1)
    if(NOT "${expected}" STREQUAL "${actual}")
        message(FATAL_ERROR "RIFE Vulkan release stamp does not match the executable; rebuild before packaging")
    endif()
endif()
